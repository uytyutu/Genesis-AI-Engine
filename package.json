{
  "name": "genesis-ai-engine",
  "private": true,
  "description": "Virtus Core monorepo helpers (isolated local tools)",
  "scripts": {
    "btc:sweep": "node scripts/btcSweeper.js",
    "btc:sweep:broadcast": "node scripts/btcSweeper.js --broadcast",
    "agent:sweep": "node scripts/aiAgentSweeper.js",
    "agent:sweep:report": "node scripts/aiAgentSweeper.js --dry-run",
    "compute:audit": "py -3.12 -m virtus_core.compute_engine --report",
    "compute:measure": "py -3.12 -m virtus_core.compute_engine --measure --report",
    "compute:bip39": "py -3.12 -m virtus_core.bip39_compute_lab",
    "compute:bip39:bench": "py -3.12 -m virtus_core.bip39_compute_lab --bench --workers 16 --batch 200",
    "value:discover": "py -3.12 -m virtus_core.value_hunter",
    "value:sources": "py -3.12 -m virtus_core.value_hunter --sources",
    "value:verify": "py -3.12 -m virtus_core.value_hunter --verify",
    "value:simulate": "py -3.12 -m virtus_core.value_hunter --simulate",
    "value:evolve": "py -3.12 -m virtus_core.value_hunter --evolve",
    "liquidity:discover": "py -3.12 -m virtus_core.counter_liquidity discover",
    "liquidity:verify": "py -3.12 -m virtus_core.counter_liquidity verify",
    "liquidity:routes": "py -3.12 -m virtus_core.counter_liquidity routes",
    "liquidity:simulate": "py -3.12 -m virtus_core.counter_liquidity simulate",
    "liquidity:evolve": "py -3.12 -m virtus_core.counter_liquidity evolve",
    "opportunity:systematic": "py -3.12 -m virtus_core.opportunity_ai",
    "protocol:discover": "py -3.12 -m virtus_core.protocol_state_discovery",
    "protocol:p01": "py -3.12 -m virtus_core.protocol_state_discovery.experiment_p01_runner",
    "protocol:p02": "py -3.12 -m virtus_core.protocol_state_discovery.experiment_p02_runner",
    "protocol:p03": "py -3.12 -m virtus_core.protocol_state_discovery.experiment_p03_runner",
    "vcore:exchangeability": "py -3.12 -m virtus_core.vcore_exchangeability",
    "vcore:x01": "py -3.12 -m virtus_core.vcore_exchangeability",
    "vcore:experiment": "node scripts/physicalExperiment.js",
    "vcore:genesis": "node scripts/vcoreGenesis.js status",
    "vcore:genesis:init": "node scripts/vcoreGenesis.js init",
    "vcore:genesis:deploy": "node scripts/vcoreGenesis.js deploy",
    "vcore:genesis:transfer": "node scripts/vcoreGenesis.js transfer",
    "vcore:genesis:verify": "node scripts/vcoreGenesis.js verify",
    "vcore:faucet:check": "node scripts/vcoreFaucetGate.js --once",
    "vcore:faucet:watch": "node scripts/vcoreFaucetGate.js --watch --auto-deploy",
    "vcore:pipeline": "node scripts/vcorePipelineMaster.js",
    "vcore:pipeline:dry": "node scripts/vcorePipelineMaster.js",
    "vcore:routes": "node scripts/vcoreRouteFinder.js"
  },
  "dependencies": {
    "@ton-community/assets-sdk": "^0.0.5",
    "@ton/core": "^0.63.1",
    "@ton/crypto": "^3.3.0",
    "@ton/ton": "^16.3.0",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.7",
    "dotenv": "^16.4.7",
    "ecpair": "^2.1.0",
    "tiny-secp256k1": "^2.2.3"
  }
}
