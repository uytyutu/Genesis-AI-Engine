# Локальный BTC sweeper / agent — НЕ коммитить с реальными ключами.
# Скопируйте в .env.btc в корне репозитория.
#
# Запуск:
#   npm run agent:sweep:report   # отчёт без отправки
#   npm run agent:sweep          # отчёт + y/N + broadcast

# Обязательно: ваш Vault (куда сводить)
VAULT_BTC_ADDRESS=bc1q_your_company_vault

# Один из вариантов ключа (ТОЛЬКО свои):
# BTC_PRIVATE_KEY=cYourWifOrMainnetWif…
# BTC_WALLET_SEED=word1 word2 … word12/24

# Опционально:
# BTC_DERIVE_COUNT=5
# BTC_FEE_MODE=hour
# MEMPOOL_API=https://mempool.space/api
